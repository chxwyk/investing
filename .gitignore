# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# Release bundles handed to the operator. Built from the tagged commit on
# demand, so committing one would be storing a second copy of history that can
# silently drift from the source it was cut from.
*.zip

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local runtime state — never commit a runner database; it holds the
# forward-observation history the calibration commands read.
*.db
*.db-wal
*.db-shm
.env
.env.*
